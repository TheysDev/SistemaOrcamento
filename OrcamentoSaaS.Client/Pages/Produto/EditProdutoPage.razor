@page "/produto/editar/{Id:guid}"

@using OrcamentoSaaS.Client.Componentes.Produto
@using OrcamentoSaaS.Shared.Dtos.Produtos

@inject ProdutoService ProdutoService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

@implements IDisposable

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-3">@_errorMessage</MudAlert>
}

@if (_isCarregando)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
}
else if (_model != null)
{
    <MudContainer MaxWidth="MaxWidth.Medium" Class="my-4">
        
        <CardProdutoForm Model="_model"
                         IsEditMode="true"
                         ButtonText="Editar Produto"
                         TitleText="Editar Produto"
                         IsLoading="_isLoading"
                         OnValidSubmit="AtualizarAsync"
                         OnCancel="@(() => Navigation.NavigateTo("/produto/listar"))"/>
    </MudContainer>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private ProdutoEditRequest? _model;
    
    private bool _isCarregando = true;
    private bool _isLoading;
    
    private string? _errorMessage;
    
    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await ProdutoService.GetByIdAsync(Id, _cts.Token);

            if (result is { IsSuccess: true, Value: not null })
            {
                _model = new ProdutoEditRequest
                {
                    Codigo =  result.Value.Codigo,
                    Descricao =  result.Value.Descricao,
                    Valor = result.Value.Valor,
                    Detalhes =  result.Value.Detalhes
                };
            }
            else
            {
                _errorMessage = result.Error ?? "Produto não encontrado.";
            }
        }
        catch (OperationCanceledException)
        {}
        finally 
        {
            _isCarregando = false;
        }
    }

    private async Task AtualizarAsync()
    {
        try
        {
            _isLoading = true;
            _errorMessage = null;
            
            var result = await ProdutoService.EditarProdutoAsync(Id, _model!);
        
            if (!result.IsSuccess)
            {
                _errorMessage = result.Error;
                _isLoading = false;
                return;
            }

            Snackbar.Add("Produto atualizado com sucesso!", Severity.Success);
            Navigation.NavigateTo("/produto/listar");
        }
        catch (Exception ex)
        {
            _errorMessage = $"Ocorreu um erro inesperado: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
        
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

}

   