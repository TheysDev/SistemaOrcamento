@page "/cliente/listar"

@using OrcamentoSaaS.Client.Componentes.Shared
@using OrcamentoSaaS.Shared.Dtos.Clientes

@inject ClienteService ClienteService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@implements IDisposable

<PageTitle>Clientes</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-4">
    <MudCard Elevation="3" Class="rounded-lg">
        <MudTable T="ClienteResponse"
                  ServerData="LoadServerData"
                  Hover="true"
                  Dense="false"
                  Elevation="0"
                  @ref="_table">

            <ToolBarContent>
                <div class="d-flex align-center gap-3">
                    <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                        <MudIcon Icon="@Icons.Material.Filled.People" />
                    </MudAvatar>
                    <div>
                        <MudText Typo="Typo.h6" Class="font-weight-bold">Clientes</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Gerencie sua carteira de clientes cadastrados</MudText>
                    </div>
                </div>

                <MudSpacer />

                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    <MudTextField @bind-Value="_search"
                                  Placeholder="Buscar por nome ou documento"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  IconSize="Size.Medium"
                                  Clearable="true"
                                  OnClearButtonClick="PesquisarAsync"
                                  OnKeyDown="OnSearchKeyDown"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Style="min-width: 300px;"
                                  Class="mt-0" />
                    
                </MudStack>
            </ToolBarContent>

            <HeaderContent>
                <MudTh>Cliente</MudTh>
                <MudTh>Documento</MudTh>
                <MudTh>Contato</MudTh>
                <MudTh>Localização</MudTh>
                <MudTh Style="text-align: center;">Ações</MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd DataLabel="Cliente">
                    <div class="d-flex align-center gap-2">
                        <MudAvatar Color="Color.Secondary" Variant="Variant.Outlined" Size="Size.Small">
                            @context.Nome.FirstOrDefault()
                        </MudAvatar>
                        <MudText Typo="Typo.body1" Class="fw-bold">@context.Nome</MudText>
                    </div>
                </MudTd>

                <MudTd DataLabel="Documento">
                    <MudText Typo="Typo.body1" Class="fw-bold">
                        @FormatarDocumento(context.Documento)
                    </MudText>
                </MudTd>

                <MudTd DataLabel="Contato">
                    <div class="d-flex flex-column">
                        <span class="d-flex align-center gap-1">
                            <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" Color="Color.Secondary" Style="font-size: 0.9rem;" />
                            <MudText Typo="Typo.body2">@context.Email</MudText>
                        </span>
                        @if (!string.IsNullOrWhiteSpace(context.Telefone))
                        {
                            <span class="d-flex align-center gap-1 mt-1">
                                <MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" Color="Color.Secondary" Style="font-size: 0.9rem;" />
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Telefone</MudText>
                            </span>
                        }
                    </div>
                </MudTd>

                <MudTd DataLabel="Localização">
                    @if (!string.IsNullOrWhiteSpace(context.Cidade))
                    {
                        <div class="d-flex align-center gap-1">
                            <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Color="Color.Secondary" Style="font-size: 0.9rem;" />
                            <MudText Typo="Typo.body2">@context.Cidade/@context.Uf</MudText>
                        </div>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">-</MudText>
                    }
                </MudTd>

                <MudTd DataLabel="Ações">
                    <MudStack Row="true" Spacing="1" Justify="Justify.Center" AlignItems="AlignItems.Center">
                        <MudTooltip Text="Detalhes">
                            <MudIconButton Href="@($"/cliente/detalhes/{context.Id}")"
                                           Icon="@Icons.Material.Outlined.Visibility"
                                           Size="Size.Small"
                                           Color="Color.Info" />
                        </MudTooltip>

                        <MudTooltip Text="Editar">
                            <MudIconButton Href="@($"/cliente/editar/{context.Id}")"
                                           Icon="@Icons.Material.Filled.Edit"
                                           Size="Size.Small"
                                           Color="Color.Primary" />
                        </MudTooltip>

                        <MudTooltip Text="Excluir">
                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                           OnClick="@(() => DeleteClienteAsync(context.Id))"
                                           Size="Size.Small"
                                           Color="Color.Error" />
                        </MudTooltip>
                    </MudStack>
                </MudTd>
            </RowTemplate>

            <NoRecordsContent>
                <div class="pa-8 text-center">
                    <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Secondary" />
                    <MudText Typo="Typo.body1" Class="mt-2" Color="Color.Secondary">Nenhum cliente encontrado.</MudText>
                </div>
            </NoRecordsContent>

            <LoadingContent>
                <div class="pa-8 text-center">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Medium" />
                    <MudText Typo="Typo.body2" Class="mt-2">Carregando dados...</MudText>
                </div>
            </LoadingContent>

            <PagerContent>
                <MudTablePager PageSizeOptions="[10, 20, 50]" 
                               RowsPerPageString="Linhas por página:" 
                               InfoFormat="{first_item}-{last_item} de {all_items}" />
            </PagerContent>
        </MudTable>
    </MudCard>
</MudContainer>

@code {
    private readonly CancellationTokenSource _cts = new();
    
    private MudTable<ClienteResponse>? _table;
    private string _search = string.Empty;

    private static string FormatarDocumento(string? doc)
    {
        if (string.IsNullOrWhiteSpace(doc)) return "-";
        var digitos = new string(doc.Where(char.IsDigit).ToArray());

        if (digitos.Length == 11)
            return Convert.ToUInt64(digitos).ToString(@"000\.000\.000\-00");
        if (digitos.Length == 14)
            return Convert.ToUInt64(digitos).ToString(@"00\.000\.000\/0000\-00");

        return doc;
    }

    private async Task<TableData<ClienteResponse>> LoadServerData(TableState state, CancellationToken ct)
    {
        var query = new ClienteQuery(
            Pagina: state.Page + 1,
            TamanhoPagina: state.PageSize,
            Busca: _search);

        try
        {
            var response = await ClienteService.BuscarClientesAsync(query, ct);

            return new TableData<ClienteResponse>
            {
                Items = response?.Itens ?? [],
                TotalItems = response?.TotalItens ?? 0
            };
        }
        catch (OperationCanceledException)
        {
            return new TableData<ClienteResponse> { Items = [], TotalItems = 0 };
        }
        catch(Exception)
        {
            Snackbar.Add("Erro ao carregar clientes.", Severity.Error);
            return new TableData<ClienteResponse> { Items = [], TotalItems = 0 };
        }
    }

    private async Task PesquisarAsync()
    {
        if (_table is not null)
            await _table.ReloadServerData();
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            await PesquisarAsync();
    }

    private async Task DeleteClienteAsync(Guid id)
    {
        var parameters = new DialogParameters<ModalConfirmar>
        {
            { x => x.ContentText, "Tem certeza que deseja deletar este cliente? Esta ação não pode ser desfeita." },
            { x => x.ButtonText, "Deletar" }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };
        var dialog = await DialogService.ShowAsync<ModalConfirmar>("Deletar Cliente", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            var resultado = await ClienteService.DeleteClienteAsync(id, _cts.Token);

            if (resultado.IsSuccess)
            {
                Snackbar.Add("Cliente excluído com sucesso!", Severity.Success);
                if (_table is not null)
                    await _table.ReloadServerData();
            }
            else
            {
                Snackbar.Add(resultado.Error, Severity.Error);
            }
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}