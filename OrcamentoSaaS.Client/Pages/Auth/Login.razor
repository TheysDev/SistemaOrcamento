@page "/"
@page "/login"

@using OrcamentoSaaS.Shared.Dtos.Auth

@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

<PageTitle>Login</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center min-vh-100 py-8">
    <MudCard Elevation="4" Class="rounded-lg pa-4" Style="width: 100%; max-width: 450px;">
        
        <MudCardHeader Class="d-flex flex-column align-center text-center pb-2">
            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.LockPerson" Size="Size.Medium" />
            </MudAvatar>
            <MudText Typo="Typo.h5" Class="font-weight-bold">Acessar Conta</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Informe suas credenciais para continuar
            </MudText>
        </MudCardHeader>

        <MudCardContent Class="px-6 py-2">
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="@(() => _errorMessage = null)">
                    @_errorMessage
                </MudAlert>
            }

            <MudForm @ref="_form" @bind-IsValid="_isValid">
                <MudGrid Spacing="2">
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_model.Email"
                                      Label="E-mail"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      InputType="InputType.Email"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Email"
                                      For="@(() => _model.Email)"
                                      Immediate="true"
                                      Disabled="@_isLoading" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField @bind-Value="_model.Password"
                                      Label="Senha"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@(_showPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                      OnAdornmentClick="@(() => _showPassword = !_showPassword)"
                                      For="@(() => _model.Password)"
                                      OnKeyUp="OnKeyUpPassword"
                                      Immediate="true"
                                      Disabled="@_isLoading" />
                    </MudItem>
                </MudGrid>
            </MudForm>
        </MudCardContent>

        <MudCardActions Class="px-6 pb-6 pt-2 d-flex flex-column gap-3">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large"
                       OnClick="FazerLoginAsync"
                       Disabled="@(_isLoading || !_isValid)">
                @if (_isLoading)
                {
                    <MudProgressCircular Class="ms-n1 me-2" Size="Size.Small" Indeterminate="true" />
                    <span>Entrando...</span>
                }
                else
                {
                    <span>Entrar</span>
                }
            </MudButton>

            <div class="d-flex align-center justify-center gap-1 mt-2">
                <MudText Typo="Typo.body2" Color="Color.Secondary">Não tem uma conta?</MudText>
                <MudLink Href="/register" Typo="Typo.body2" Color="Color.Primary" Class="fw-bold">
                    Cadastre-se
                </MudLink>
            </div>
        </MudCardActions>
    </MudCard>
</MudContainer>

@code {
    private MudForm _form = null!;
    private bool _isValid;
    private bool _isLoading;
    private bool _showPassword;
    private string? _errorMessage;

    private readonly LoginModel _model = new();
    
    private HttpClient Http => HttpClientFactory.CreateClient("Api");

    private async Task OnKeyUpPassword(KeyboardEventArgs args)
    {
        if (args.Key is "Enter" or "NumpadEnter")
        {
            await FazerLoginAsync();
        }
    }

    private async Task FazerLoginAsync()
    {
        await _form.Validate();
        if (!_isValid) return;

        _isLoading = true;
        _errorMessage = null;

        try
        {
            // O MapIdentityApi expõe nativamente POST /login
            var response = await Http.PostAsJsonAsync("api/login", new
            {
                email = _model.Email,
                password = _model.Password
            });

            if (response.IsSuccessStatusCode)
            {
                var loginData = await response.Content.ReadFromJsonAsync<LoginResponse>();
                
                // Aqui você pode salvar loginData.AccessToken no LocalStorage ou chamar seu AuthenticationStateProvider
                Snackbar.Add("Login realizado com sucesso!", Severity.Success);
                NavigationManager.NavigateTo("/orcamento/listar");
            }
            else
            {
                _errorMessage = "E-mail ou senha incorretos.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Falha de conexão com o servidor: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }
}