@page "/register"

@using OrcamentoSaaS.Shared.Dtos.Auth

@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

<PageTitle>Criar Conta</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center min-vh-100 py-8">
    <MudCard Elevation="4" Class="rounded-lg pa-4" Style="width: 100%; max-width: 450px;">
        
        <MudCardHeader Class="d-flex flex-column align-center text-center pb-2">
            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Size="Size.Medium" />
            </MudAvatar>
            <MudText Typo="Typo.h5" Class="font-weight-bold">Criar Nova Conta</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Preencha os campos para iniciar seu cadastro
            </MudText>
        </MudCardHeader>

        <MudCardContent Class="px-6 py-2">
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="@(() => _errorMessage = null)">
                    @_errorMessage
                </MudAlert>
            }

            <MudForm @ref="_form" @bind-IsValid="_isValid">
                <MudGrid Spacing="2">
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_model.Email"
                                      Label="E-mail"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      InputType="InputType.Email"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Email"
                                      For="@(() => _model.Email)"
                                      Immediate="true"
                                      Disabled="@_isLoading" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField @bind-Value="_model.Password"
                                      Label="Senha"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@(_showPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                      OnAdornmentClick="@(() => _showPassword = !_showPassword)"
                                      For="@(() => _model.Password)"
                                      Immediate="true"
                                      Disabled="@_isLoading" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField @bind-Value="_model.ConfirmPassword"
                                      Label="Confirmar Senha"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@(_showPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                      OnAdornmentClick="@(() => _showPassword = !_showPassword)"
                                      For="@(() => _model.ConfirmPassword)"
                                      Immediate="true"
                                      Disabled="@_isLoading" />
                    </MudItem>
                </MudGrid>
            </MudForm>
        </MudCardContent>

        <MudCardActions Class="px-6 pb-6 pt-2 d-flex flex-column gap-3">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large"
                       OnClick="RegistrarAsync"
                       Disabled="@(_isLoading || !_isValid)">
                @if (_isLoading)
                {
                    <MudProgressCircular Class="ms-n1 me-2" Size="Size.Small" Indeterminate="true" />
                    <span>Cadastrando...</span>
                }
                else
                {
                    <span>Registrar</span>
                }
            </MudButton>

            <div class="d-flex align-center justify-center gap-1 mt-2">
                <MudText Typo="Typo.body2" Color="Color.Secondary">Já tem uma conta?</MudText>
                <MudLink Href="/login" Typo="Typo.body2" Color="Color.Primary" Class="fw-bold">
                    Entrar
                </MudLink>
            </div>
        </MudCardActions>
    </MudCard>
</MudContainer>

@code {
    private MudForm _form = null!;
    private bool _isValid;
    private bool _isLoading;
    private bool _showPassword;
    private string? _errorMessage;

    private readonly RegisterModel _model = new();
    
    private HttpClient Http => HttpClientFactory.CreateClient("Api");

    private async Task RegistrarAsync()
    {
        await _form.Validate();
        if (!_isValid) return;

        _isLoading = true;
        _errorMessage = null;

        try
        {
            // O MapIdentityApi expõe nativamente POST /register
            var response = await Http.PostAsJsonAsync("api/register", new
            {
                email = _model.Email,
                password = _model.Password
            });

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Conta cadastrada com sucesso! Faça login para entrar.", Severity.Success);
                NavigationManager.NavigateTo("/login");
            }
            else
            {
                // Extrai erros de validação retornados pelo Identity (ex: senha fraca, e-mail já em uso)
                var problem = await response.Content.ReadFromJsonAsync<IdentityProblemDetails>();
                
                if (problem?.Errors is not null && problem.Errors.Any())
                {
                    _errorMessage = string.Join(" ", problem.Errors.SelectMany(e => e.Value));
                }
                else
                {
                    _errorMessage = "Não foi possível realizar o cadastro. Verifique os dados inseridos.";
                }
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Ocorreu um erro: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    public class IdentityProblemDetails
    {
        public Dictionary<string, string[]>? Errors { get; set; }
    }
}