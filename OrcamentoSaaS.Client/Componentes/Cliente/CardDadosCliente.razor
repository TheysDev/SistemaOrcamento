@using OrcamentoSaaS.Shared.Dtos.Clientes

<MudCard Elevation="2" Class="h-100 w-100 d-flex flex-column" Style="width: 100%;">
    
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">Dados do Cliente</MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Primary"/>
        </CardHeaderActions>
    </MudCardHeader>
    
    <MudDivider />
    
    <MudCardContent Class="flex-grow-1">
        <MudGrid Spacing="2">
            
            <MudItem xs="12" sm="6">
                <div class="d-flex align-center gap-3">
                    <MudIcon Icon="@Icons.Material.Filled.Badge" Size="Size.Small" Color="Color.Primary"/>
                    <div>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Razão Social / Nome</MudText>
                        <MudText Typo="Typo.body2"><b>@Cliente.Nome</b></MudText>
                    </div>
                </div>
            </MudItem>
            
            <MudItem xs="12" sm="6">
                <div class="d-flex align-center gap-3">
                    <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" Color="Color.Primary"/>
                    <div>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">CNPJ / CPF</MudText>
                        <MudText Typo="Typo.body2"><b>@Cliente.Documento</b></MudText>
                    </div>
                </div>
            </MudItem>
            
            <MudItem xs="12" sm="6">
                <div class="d-flex align-center gap-3">
                    <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" Color="Color.Primary"/>
                    <div>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">E-mail</MudText>
                        <MudText Typo="Typo.body2">@Cliente.Email</MudText>
                    </div>
                </div>
            </MudItem>
            
            <MudItem xs="12" sm="6">
                <div class="d-flex align-center gap-3">
                    <MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" Color="Color.Primary"/>
                    <div>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Telefone</MudText>
                        <MudText Typo="Typo.body2">@(string.IsNullOrEmpty(Cliente.Telefone) ? "Não Informado" :Cliente.Telefone)</MudText>
                    </div>
                </div>
            </MudItem>
            
            <MudItem xs="12" sm="6">
            <div class="d-flex align-center gap-3">
                <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Color="Color.Primary"/>
                <div>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Localidade</MudText>
                    <MudText Typo="Typo.body2">@($"{Cliente.Cidade} - {Cliente.Uf}")</MudText>
                </div>
            </div>
            </MudItem>
        </MudGrid>
    </MudCardContent>
    
</MudCard>

@code {
    [Parameter] public ClienteResponse Cliente { get; set; } = null!;
}

