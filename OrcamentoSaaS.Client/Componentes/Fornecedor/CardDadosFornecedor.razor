@using OrcamentoSaaS.Shared.Dtos.Fornecedores

<MudCard Elevation="3" Class="h-100 w-100 d-flex flex-column" Style="width: 100%;">
    
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">Dados do Fornecedor</MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Primary"/>
        </CardHeaderActions>
    </MudCardHeader>

    <MudDivider/>

    <MudCardContent Class="flex-grow-1">
        <MudGrid Spacing="2">
            
            <MudItem xs="12" sm="6">
                <div class="d-flex align-center gap-3">
                    <MudIcon Icon="@Icons.Material.Filled.Badge" Size="Size.Small" Color="Color.Primary"/>
                    <div>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Razão Social / Nome</MudText>
                        <MudText Typo="Typo.body2"><b>@Model.Fornecedor.Nome</b></MudText>
                    </div>
                </div>
            </MudItem>
            
            <MudItem xs="12" sm="6">
                <div class="d-flex align-center gap-3">
                    <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" Color="Color.Primary"/>
                    <div>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">CNPJ / CPF</MudText>
                        <MudText Typo="Typo.body2"><b>@Model.Fornecedor.Documento</b></MudText>
                    </div>
                </div>
            </MudItem>

            <MudItem xs="12" sm="6">
                <div class="d-flex align-center gap-3">
                    <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" Color="Color.Primary"/>
                    <div>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">E-mail</MudText>
                        <MudText Typo="Typo.body2">@Model.Fornecedor.Email</MudText>
                    </div>
                </div>
            </MudItem>
            
            <MudItem xs="12" sm="6">
                <div class="d-flex align-center gap-3">
                    <MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" Color="Color.Primary"/>
                    <div>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Telefone</MudText>
                        <MudText Typo="Typo.body2">@(string.IsNullOrEmpty(Model.Fornecedor.Telefone) ? "Não Informado" : Model.Fornecedor.Telefone)</MudText>
                    </div>
                </div>
            </MudItem>
            
            <MudItem xs="12" sm="6">
                <div class="d-flex align-center gap-3">
                    <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Color="Color.Primary"/>
                    <div>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Localidade</MudText>
                        <MudText Typo="Typo.body2">@($"{Model.Fornecedor.Cidade} - {Model.Fornecedor.Uf}")</MudText>
                    </div>
                </div>
            </MudItem>
            
            <MudItem xs="12">
                <div class="d-flex align-center gap-3">
                    <MudIcon Icon="@Icons.Material.Filled.Percent" Size="Size.Small" Color="Color.Primary"/>
                    <div>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Condições de Margem</MudText>
                        <div class="d-flex gap-2 mt-1">
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">
                                À Vista: @Model.PorcentagemAVista.ToString("N2")%
                            </MudChip>
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                                A Prazo: @Model.PorcentagemAPrazo.ToString("N2")%
                            </MudChip>
                        </div>
                    </div>
                </div>
            </MudItem>
            
        </MudGrid>
    </MudCardContent>
</MudCard>

@code {
    [Parameter, EditorRequired] public FornecedorDetalhesResponse Model { get; set; } = null!;

    private static string FormatarDocumento(string? doc)
    {
        if (string.IsNullOrWhiteSpace(doc)) return "-";
        var digitos = new string(doc.Where(char.IsDigit).ToArray());

        if (digitos.Length == 11)
            return Convert.ToUInt64(digitos).ToString(@"000\.000\.000\-00");
        if (digitos.Length == 14)
            return Convert.ToUInt64(digitos).ToString(@"00\.000\.000\/0000\-00");

        return doc;
    }
}