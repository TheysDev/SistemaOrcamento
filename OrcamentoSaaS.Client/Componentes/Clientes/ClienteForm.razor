@using OrcamentoSaaS.Shared
@using OrcamentoSaaS.Shared.Dtos.Clientes

<MudForm @ref="_form" @bind-IsValid="@_isValid">
    <MudGrid Spacing="2">
        <MudItem xs="12" md="6">
            <MudTextField @bind-Value="Model.Nome" Label="Nome" Variant="Variant.Outlined" Margin="Margin.Dense" For="@(() => Model.Nome)" />
        </MudItem>
        <MudItem xs="12" md="6">
            <MudTextField @bind-Value="Model.Cidade" Label="Cidade" Variant="Variant.Outlined" Margin="Margin.Dense" For="@(() => Model.Cidade)" />
        </MudItem>
        <MudItem xs="12" md="6">
            <MudTextField @bind-Value="Model.Uf" Label="UF" Variant="Variant.Outlined" Margin="Margin.Dense" For="@(() => Model.Uf)" />
        </MudItem>
        <MudItem xs="12" md="6">
            <MudTextField @bind-Value="Model.Email" Label="E-mail" Variant="Variant.Outlined" Margin="Margin.Dense" For="@(() => Model.Email)" />
        </MudItem>
        <MudItem xs="12" md="6">
            <MudTextField @bind-Value="Model.Telefone" 
                          Label="Telefone" 
                          Variant="Variant.Outlined" 
                          Margin="Margin.Dense" 
                          Mask="@(new PatternMask("(00) 00000-0000"))" 
                          For="@(() => Model.Telefone)" />
        </MudItem>
        <MudItem xs="12" md="6">
            <MudTextField @bind-Value="Model.Documento" 
                          Label="Documento (CPF/CNPJ)" 
                          Variant="Variant.Outlined"
                          Disabled="@IsEditMode"
                          HelperText="@(IsEditMode ? "O documento não pode ser alterado." : "")"
                          Margin="Margin.Dense" 
                          Mask="@(new PatternMask("00.000.000/0000-00"))" 
                          For="@(() => Model.Documento)" />
        </MudItem>

        <MudItem xs="12">
            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                <MudButton Variant="Variant.Filled" OnClick="OnCancel">Voltar</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" Disabled="@IsLoading">
                    @(IsLoading ? "Salvando..." : ButtonText)
                </MudButton>
            </MudStack>
        </MudItem>
    </MudGrid>
</MudForm>

@code {
    [Parameter, EditorRequired] public ClienteBaseRequest Model { get; set; } = default!;
    
    [Parameter] public bool IsEditMode { get; set; } = false;
    
    [Parameter] public string ButtonText { get; set; } = "Salvar";
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public EventCallback OnValidSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private MudForm _form = null!;
    private bool _isValid;

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (_form.IsValid)
        {
            await OnValidSubmit.InvokeAsync();
        }
    }
}
